{
  "name": "newscribe",
  "version": "0.1.1",
  "private": true,
  "description": "NewScribe — 手绘白板动画工作台",
  "author": "祝鱼贵 (Eguersi)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eguersi/NewScribe.git"
  },
  "homepage": "https://github.com/eguersi/NewScribe",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "postinstall": "node scripts/ensure-electron.mjs",
    "diagnose": "electron-vite build && electron . --diagnose",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2026.9.2",
    "fflate": "^0.8.3",
    "mathjax-full": "3.2.2",
    "mp4-muxer": "^5.2.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
